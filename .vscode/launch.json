{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Cargo launch (codex CLI)",
      "cargo": {
        "cwd": "${workspaceFolder}/codex-rs",
        "args": ["build", "--bin", "codex"]
      },
      "program": "${workspaceFolder}/codex-rs/target/debug/codex",
      "args": []
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Cargo launch (codex-tui)",
      "cargo": {
        "cwd": "${workspaceFolder}/codex-rs",
        "args": ["build", "--bin", "codex-tui"]
      },
      "program": "${workspaceFolder}/codex-rs/target/debug/codex-tui",
      "args": []
    },
    {
      "type": "lldb",
      "request": "attach",
      "name": "Attach to running codex CLI",
      "pid": "${command:pickProcess}",
      "sourceLanguages": ["rust"]
    }
  ]
}
