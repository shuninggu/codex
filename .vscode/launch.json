{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Cargo launch",
      "program": "${workspaceFolder}/codex-rs/target/debug/codex-tui",
      "args": [],
      "cwd": "${workspaceFolder}/codex-rs",
      "preLaunchTask": "cargo: build codex-tui",
      "env": {
        "CODEX_GITHUB_PAT": "${env:CODEX_GITHUB_PAT}"
      }
    },
    {
      "type": "lldb",
      "request": "attach",
      "name": "Attach to running codex CLI",
      "pid": "${command:pickProcess}",
      "sourceLanguages": ["rust"]
    }
  ]
}
